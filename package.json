{
  "name": "roadstar-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "api": "node services/api/src/server.ts",
    "migrate": "node services/api/src/db.ts",
    "test:integration": "node --test tests/postgres.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@google-cloud/storage": "^8.1.0",
    "@google-cloud/tasks": "^7.1.0",
    "@google/genai": "^2.21.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.3",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.0.2",
    "pg": "^8.23.0",
    "zod": "^4.6.1"
  }
}
