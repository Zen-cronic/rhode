# Native apps require a reachable operational API. Android USB can forward loopback.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4010
# Explicit synthetic identity buttons, accepted only by the local-demo API.
EXPO_PUBLIC_AUTH_MODE=local-demo
# For authenticated preview use Firebase mode and an HTTPS API origin.
# EXPO_PUBLIC_AUTH_MODE=firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Android package/signing-certificate restricted key. Enable Maps SDK for Android.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Existing Expo/EAS project UUID; create native APNs/FCM credentials separately.
EXPO_PUBLIC_EAS_PROJECT_ID=
